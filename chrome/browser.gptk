[config]
repeat_delay = 16
repeat_rate = 40
# mouse_scale: số càng LỚN càng CHẬM (PortMaster: 8192 cho màn 640px).
# Màn Brick 1024px -> ~5000; nhanh/chậm thì Tai chỉnh tiếp trên máy.
mouse_scale = 5000
mouse_delay = 16
deadzone_mode = axial
deadzone_scale = 10
deadzone_x = 1800
deadzone_y = 1800
deadzone_triggers = 3000
mouse_slow_scale = 30
dpad_mouse_normalize = true

[controls]
# Mapping tay cầm của RC-Web (RomCloud tự định nghĩa, Tai chốt):
# Joystick: rê chuột hệ thống của weston (chế độ con trỏ SELECT dùng
# nó để di chuyển, A = bấm). Không có 2 dòng left/right_analog dưới
# thì gạt cần không sinh event chuột nào cả.
# D-pad: trái = lui trang, phải = tới trang, lên/xuống = cuộn bước nhỏ
# (phím mũi tên gốc của trang). L1/R1 = cuộn cả trang (PageUp/PageDown).
# START = địa chỉ (F6), SELECT = con trỏ (F9) — qua main.js.
# B do RomCloud giữ (thoát theo tầng): F1 chỉ để main.js đóng lớp
# phụ (bàn phím/con trỏ) trong lúc RomCloud nhường.
#
# QUAN TRỌNG — token gptokeyb2 là tên SDL theo VỊ TRÍ nút, không phải
# chữ in trên máy TrimUI (bố cục Nintendo: A phải, B dưới, X trên, Y trái):
#   token a = nút B vật lý (dưới)   token b = nút A vật lý (phải)
#   token x = nút Y vật lý (trái)   token y = nút X vật lý (trên)
# Bằng chứng máy thật 2026-10-10 (log rc-web.log phiên 10:59 UTC):
# với bản cũ (a=f2, b=f1, x=enter, y=f3), Tai bấm Y thì gõ chữ
# (x=enter -> Enter) và bấm X thì xoá (y=f3 -> F3) — khớp từng dòng.
# Sơ đồ Tai chốt: A chọn, Y xoá, START tải web, B đóng/thoát, X trang chủ:
# LƯU Ý token nút phụ của gptokeyb2 theo tên Xbox: SELECT vật lý = `back`
# (không phải `select` — token đó không tồn tại, ghi là mất nút câm).
a = f1
b = enter
x = f3
y = f2
l1 = pageup
r1 = pagedown
start = f6
back = f9
up = up
down = down
left = f7
right = f8
# Cần gạt -> chuột tương đối của weston (xem chú thích đầu file).
# Map cả 2 cần: máy chỉ có 1 cần thì dòng thừa vô tác dụng.
left_analog = mouse_movement
right_analog = mouse_movement
