name = "romcloud-issue-relay"
main = "src/index.ts"
compatibility_date = "2024-01-01"
compatibility_flags = ["nodejs_compat"]

# Workers AI not needed, using fetch API only

# Environment variables (set via `wrangler secret put`)
# GITHUB_TOKEN - GitHub fine-grained PAT (only Issues:ReadWrite for Romcloud_Logs)
# GITHUB_REPO_OWNER - "bun2it"
# GITHUB_REPO_NAME - "Romcloud_Logs"

# KV Namespace for deduplication
kv_namespaces = [
  { binding = "ISSUES_KV", id = "" }  # Create via: wrangler kv:namespace create "issues_kv"
]

[env.production]
name = "romcloud-issue-relay"
kv_namespaces = [
  { binding = "ISSUES_KV", id = "", preview_id = "" }
]

[vars]
WORKER_VERSION = "1.0.0"
APP_NAME = "RomCloud"
